# Set the Graph API version supported by your Meta App in functions/.env.<PROJECT_ID>
META_GRAPH_VERSION=v26.0

# Public Meta App configuration (never put App Secret or tokens here)
META_APP_ID=
META_REDIRECT_URI=https://YOUR_DOMAIN/index.html
META_WEBHOOK_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/metaWebhook
# Studio AI: server-only image model. Uses the existing OPENAI_API_KEY secret.
STUDIO_AI_IMAGE_MODEL=gpt-image-1.5

# ChatGPT text model, server-only. Set a model available to your OpenAI project.
OPENAI_MODEL=gpt-6-luna
# Optional assistant override; otherwise OPENAI_MODEL is used.
# ASSISTANT_OPENAI_MODEL=gpt-6-luna
# Optional text review model (must support Responses API Structured Outputs).
# CONTENT_REVIEW_OPENAI_MODEL=gpt-6-luna
