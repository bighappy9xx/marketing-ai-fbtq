rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedIn() ? profile().role : ''; }
    function director() { return role() == 'director'; }
    function branch() {
      return profile().get('branch', '') != '' ? profile().branch
        : profile().get('branchName', '') != '' ? profile().branchName
        : profile().get('branchId', '');
    }
    function department() { return profile().get('department', ''); }
    function manager() { return role() in ['director', 'branch_manager', 'department_manager']; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['name','email','role','approved','createdAt'])
        && request.resource.data.role == 'employee'
        && request.resource.data.approved == true
        && request.resource.data.email == request.auth.token.email;
      allow get: if self(uid) || manager();
      allow list: if manager();
      allow update: if director() || (
        self(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoData'])
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 180000
        && (request.resource.data.photoData == ''
          || request.resource.data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'))
      );
      allow delete: if director();
    }

    match /workspaces/{workspaceId}/{collection}/{documentId} {
      function inWorkspace() { return workspaceId == 'fbtq'; }
      function owns() { return resource.data.createdBy == request.auth.uid; }
      function taskAssignee() { return resource.data.assigneeUid == request.auth.uid; }
      function validDailyReport() {
        return request.resource.data.reportDate is string
          && request.resource.data.reportDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.monthKey is string
          && request.resource.data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.reportDate.matches('^' + request.resource.data.monthKey + '-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.revenue is number
          && request.resource.data.revenue >= 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName == profile().name
          && request.resource.data.department == (profile().keys().hasAny(['department']) ? profile().department : '');
      }
      function validRevenueEntry() {
        return request.resource.data.keys().hasAll(['reportDate','monthKey','revenue','dailyReportId','createdBy','createdByName','department','submittedAt','updatedAt','updatedBy'])
          && request.resource.data.keys().hasOnly(['reportDate','monthKey','revenue','dailyReportId','createdBy','createdByName','department','submittedAt','updatedAt','updatedBy'])
          && request.resource.data.dailyReportId == documentId
          && request.resource.data.reportDate is string
          && request.resource.data.reportDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.monthKey is string
          && request.resource.data.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.reportDate.matches('^' + request.resource.data.monthKey + '-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.revenue is number
          && request.resource.data.revenue >= 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName == profile().name
          && request.resource.data.department == (profile().keys().hasAny(['department']) ? profile().department : '')
          && request.resource.data.submittedAt is string
          && request.resource.data.updatedBy == request.auth.uid;
      }
      function dailyReportMatchesRevenueEntryAfter() {
        return existsAfter(/databases/$(database)/documents/workspaces/fbtq/revenueEntries/$(documentId))
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/revenueEntries/$(documentId)).data.dailyReportId == documentId
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/revenueEntries/$(documentId)).data.reportDate == request.resource.data.reportDate
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/revenueEntries/$(documentId)).data.monthKey == request.resource.data.monthKey
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/revenueEntries/$(documentId)).data.revenue == request.resource.data.revenue
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/revenueEntries/$(documentId)).data.createdBy == request.auth.uid;
      }
      function revenueEntryMatchesDailyReportAfter() {
        return existsAfter(/databases/$(database)/documents/workspaces/fbtq/dailyReports/$(documentId))
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/dailyReports/$(documentId)).data.reportDate == request.resource.data.reportDate
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/dailyReports/$(documentId)).data.monthKey == request.resource.data.monthKey
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/dailyReports/$(documentId)).data.revenue == request.resource.data.revenue
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/dailyReports/$(documentId)).data.createdBy == request.auth.uid;
      }
      function validInvoice() {
        return request.resource.data.keys().hasAll(['invoiceNumber','customer','item','quantity','unitPrice','total','createdBy','createdAt'])
          && request.resource.data.keys().hasOnly(['id','invoiceNumber','customer','taxId','item','quantity','unitPrice','total','note','issueDate','status','createdBy','createdByName','employee','createdAt','updatedAt','updatedBy','documentType','provider','supplier','supplierTaxId','employeeName','accountHolderName','department','metaInvoiceNumber','adAccountId','transactionIds','invoiceDate','billingPeriod','taxPeriod','amountBeforeVat','vatAmount','vatRate','pdfFileName','attachmentChunkCount','attachmentSize','attachmentMimeType'])
          && request.resource.data.customer is string
          && request.resource.data.item is string
          && request.resource.data.quantity is int
          && request.resource.data.unitPrice is number
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && (!request.resource.data.keys().hasAny(['documentType']) || (
            request.resource.data.documentType == 'meta_ads'
            && request.resource.data.provider is string
            && request.resource.data.supplier is string
            && request.resource.data.employeeName is string
            && request.resource.data.accountHolderName is string
            && request.resource.data.department is string
            && request.resource.data.adAccountId is string
            && request.resource.data.transactionIds is string
            && request.resource.data.invoiceDate is string
            && request.resource.data.invoiceDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && request.resource.data.billingPeriod is string
            && request.resource.data.taxPeriod is string
            && request.resource.data.taxPeriod.matches('^[0-9]{4}-Q[1-4]$')
            && request.resource.data.amountBeforeVat is number
            && request.resource.data.vatAmount is number
            && request.resource.data.vatRate is number
            && request.resource.data.pdfFileName is string
            && request.resource.data.attachmentChunkCount is int
            && request.resource.data.attachmentChunkCount > 0
            && request.resource.data.attachmentChunkCount <= 13
            && request.resource.data.attachmentSize is int
            && request.resource.data.attachmentSize > 0
            && request.resource.data.attachmentSize <= 5242880
            && request.resource.data.attachmentMimeType == 'application/pdf'
          ));
      }
      function validInvoiceFileChunk() {
        return request.resource.data.keys().hasAll(['invoiceId','chunkIndex','chunkCount','base64','ownerUid','createdBy','createdAt'])
          && request.resource.data.keys().hasOnly(['invoiceId','chunkIndex','chunkCount','base64','ownerUid','createdBy','createdAt'])
          && request.resource.data.invoiceId is string
          && request.resource.data.chunkIndex is int
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount > 0
          && request.resource.data.chunkCount <= 13
          && request.resource.data.chunkIndex >= 0
          && request.resource.data.chunkIndex < request.resource.data.chunkCount
          && request.resource.data.base64 is string
          && request.resource.data.base64.size() <= 600000
          && request.resource.data.base64.matches('^[A-Za-z0-9+/]+={0,2}$')
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.createdAt is string
          && existsAfter(/databases/$(database)/documents/workspaces/fbtq/invoices/$(request.resource.data.invoiceId))
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/invoices/$(request.resource.data.invoiceId)).data.createdBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/invoices/$(request.resource.data.invoiceId)).data.documentType == 'meta_ads'
          && getAfter(/databases/$(database)/documents/workspaces/fbtq/invoices/$(request.resource.data.invoiceId)).data.attachmentChunkCount == request.resource.data.chunkCount;
      }
      allow read: if signedIn() && inWorkspace() && collection != 'pages' && (
        collection == 'advanceInvoices' && (owns() || director() || role() == 'accountant' || role() == 'branch_manager' && branch() != '' && resource.data.branch == branch())
        || collection == 'staffRequests' && (owns() || director() || branch() != '' && resource.data.branch == branch() && (role() == 'branch_manager' || role() == 'department_manager' && department() != '' && resource.data.department == department()))
        || collection == 'campaigns' && (manager() || owns())
        || collection == 'settings'
        || collection == 'revenueEntries'
        || collection == 'invitations' && manager()
        || collection == 'requests' && (manager() || owns())
        || collection == 'tasks' && (manager() || taskAssignee() || owns())
        || collection in ['drafts', 'contentReviews', 'dailyReports'] && (manager() || owns())
        || collection == 'inbox' && (manager() || resource.data.ownerUid == request.auth.uid)
        || collection == 'messages' && (manager() || resource.data.ownerUid == request.auth.uid)
        || collection == 'contentTemplates' && (manager() || resource.data.status == 'approved')
        || collection == 'invoices' && (manager() || owns())
        || collection == 'invoiceFiles' && (manager() || resource.data.ownerUid == request.auth.uid)
      );

      allow create: if signedIn() && inWorkspace() && collection != 'pages' && request.resource.data.createdBy == request.auth.uid && (
        collection in ['drafts', 'contentReviews']
        || collection == 'dailyReports' && validDailyReport() && dailyReportMatchesRevenueEntryAfter()
        || collection == 'revenueEntries' && validRevenueEntry() && revenueEntryMatchesDailyReportAfter()
        || collection == 'contentTemplates' && (request.resource.data.status == 'pending' || manager() && request.resource.data.status == 'approved')
        || collection == 'tasks' && manager()
        || collection == 'campaigns'
        || collection == 'invoices' && request.resource.data.status == 'pending' && validInvoice()
        || collection == 'invoiceFiles' && validInvoiceFileChunk()
        || collection in ['settings', 'invitations'] && manager()
      );

      allow update: if signedIn() && inWorkspace() && collection != 'pages' && (
        collection == 'tasks' && (
          manager() || taskAssignee()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy','completedAt'])
            && request.resource.data.status in ['todo','doing','done']
            && ((request.resource.data.status == 'done'
              && request.resource.data.completedAt is string
              && request.resource.data.completedAt.size() <= 40)
              || (request.resource.data.status != 'done'
                && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt == null)))
        )
        || collection in ['drafts','contentReviews'] && (manager() || owns())
        || collection == 'dailyReports' && owns() && validDailyReport() && dailyReportMatchesRevenueEntryAfter()
        || collection == 'revenueEntries' && owns() && validRevenueEntry() && revenueEntryMatchesDailyReportAfter()
        || collection == 'contentTemplates' && manager()
        || collection == 'campaigns' && (manager() || owns())
        || collection in ['settings','invitations'] && manager()
        || collection == 'invoices' && manager() && resource.data.status == 'pending'
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedByName','reviewedAt','updatedAt','updatedBy'])
      );
      allow delete: if signedIn() && inWorkspace() && !(collection in ['pages','advanceInvoices','staffRequests','leaveSlots','requests']) && manager();
    }

    // Page access tokens are encrypted and accessed only by the Admin SDK in Cloud Functions.
    match /workspaces/{workspaceId}/pages/{pageId} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
